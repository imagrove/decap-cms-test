---
import { base } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { categoryLabel } from '../lib/categories';

const url = (src?: string) =>
  src ? (src.startsWith(base) ? src : `${base}${src.replace(/^\//, '')}`) : undefined;

const products = (await getCollection('products'))
  .filter((p) => p.data.status === 'active')
  .sort((a, b) => a.data.order - b.data.order);
const featured = products.filter((p) => p.data.featured).slice(0, 3);
---

<Base title="Imagrove · 硬件产品线" description="面向海外的硬件定制与批量交付，覆盖方案定义、打样验证到量产">
  <section class="hero">
    <p class="eyebrow">Imagrove</p>
    <h1>硬件定制，从方案到<em>量产交付</em></h1>
    <p class="lead">
      覆盖方案定义、打样验证与批量生产。支持外观、接口与固件定制，按项目方式推进。
    </p>
    <div class="hero-actions">
      <a class="btn" href={`${base}products/`}>浏览产品线</a>
      <a class="btn btn-ghost" href="https://imagrove.com/odm/">提交询盘</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>产品线</h2>
      <a href={`${base}products/`}>全部 {products.length} 个产品 →</a>
    </div>
    <div class="product-grid">
      {
        featured.map((product) => {
          const cover = url(product.data.cover);
          return (
            <a class="product-card" href={`${base}products/${product.id}/`}>
              {cover ? (
                <img src={cover} alt={product.data.name} loading="lazy" />
              ) : (
                <div class="product-card-noimg">无图</div>
              )}
              <div class="product-card-body">
                <h3>{product.data.name}</h3>
                <p class="product-card-model">
                  {product.data.model} · {categoryLabel(product.data.category)}
                </p>
                <p class="product-card-summary">{product.data.summary}</p>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

</Base>
