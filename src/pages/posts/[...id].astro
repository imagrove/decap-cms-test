---
import { base } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';


export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !post.data.draft || import.meta.env.DEV)
    .map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Decap 按 public_folder 写入完整 URL 前缀（已含 base），手写的相对路径则补上 base
const rawCover = post.data.cover;
const cover = rawCover
  ? rawCover.startsWith(base)
    ? rawCover
    : `${base}${rawCover.replace(/^\//, '')}`
  : undefined;
---

<Base title={post.data.title} description={post.data.description}>
  <article style="padding-top: 32px;">
    <p class="breadcrumb"><a href={`${base}posts/`}>动态</a></p>
    <h1>{post.data.title}</h1>
    <div class="meta">
      {post.data.date.toISOString().slice(0, 10)}
      {
        post.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))
      }
    </div>
    {cover && <img class="cover" src={cover} alt="" />}
    <div class="prose" style="margin-top: 24px;">
      <Content />
    </div>
  </article>
  <p style="padding: 32px 0 8px;"><a href={`${base}posts/`}>← 返回动态列表</a></p>
</Base>
