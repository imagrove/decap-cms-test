---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="动态 · Imagrove 原型">
  <section class="hero">
    <p class="eyebrow">Notes</p>
    <h1>动态</h1>
    <p class="lead">共 {posts.length} 篇 · 与产品一样，每篇对应一个 Markdown 文件</p>
  </section>

  <section class="section">
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <h3>
              <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
              {post.data.draft && <span class="draft-badge" style="margin-left: 8px;">草稿</span>}
            </h3>
            <div class="meta">{post.data.date.toISOString().slice(0, 10)}</div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
