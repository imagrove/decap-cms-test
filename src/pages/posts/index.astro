---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="文章列表 · Decap CMS 测试站">
  <h1>文章列表</h1>
  <p class="meta">共 {posts.length} 篇（含草稿预览仅在开发模式可见）</p>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <h2>
            <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
            {post.data.draft && <span class="draft-badge">草稿</span>}
          </h2>
          <div class="meta">{post.data.date.toISOString().slice(0, 10)}</div>
        </li>
      ))
    }
  </ul>
</Base>
