---
import { base } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="动态 · Imagrove">
  <section class="hero">
    <p class="eyebrow">动态</p>
    <h1>动态</h1>
    <p class="lead">{posts.length > 0 ? `共 ${posts.length} 篇文章` : '暂无发布内容'}</p>
  </section>

  <section class="section">
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <h3>
              <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
              {post.data.draft && <span class="draft-badge" style="margin-left: 8px;">草稿</span>}
            </h3>
            <div class="meta">{post.data.date.toISOString().slice(0, 10)}</div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
