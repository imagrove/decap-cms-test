---
import { base } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../lib/categories';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)
);

// 按分类分组，只保留有产品的分类
const groups = CATEGORIES.map((category) => ({
  ...category,
  items: products.filter((p) => p.data.category === category.id),
})).filter((group) => group.items.length > 0);

const coverOf = (cover?: string) =>
  cover ? (cover.startsWith(base) ? cover : `${base}${cover.replace(/^\//, '')}`) : undefined;
---

<Base title="产品目录 · Imagrove" description="按品类浏览 Imagrove 的硬件产品线">
  <section class="hero">
    <p class="eyebrow">产品线</p>
    <h1>产品目录</h1>
    <p class="lead">共 {products.length} 个产品，按品类浏览。</p>
  </section>

  <nav class="cat-nav" style="padding-top: 24px;">
    {groups.map((group) => <a href={`#${group.id}`}>{group.label}</a>)}
  </nav>

  {
    groups.map((group) => (
      <section id={group.id} class="cat-section">
        <h2 class="cat-title">{group.label}</h2>
        <div class="product-grid">
          {group.items.map((product) => {
            const cover = coverOf(product.data.cover);
            return (
              <a class="product-card" href={`${base}products/${product.id}/`}>
                {cover ? (
                  <img src={cover} alt={product.data.name} loading="lazy" />
                ) : (
                  <div class="product-card-noimg">无图</div>
                )}
                <div class="product-card-body">
                  <h3>{product.data.name}</h3>
                  <p class="product-card-model">
                    {product.data.model}
                    {product.data.status === 'eol' && ' · 停产'}
                  </p>
                  <p class="product-card-summary">{product.data.summary}</p>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))
  }
</Base>
